NODE_ENV=development
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-this-to-at-least-32-random-characters

POSTGRES_DB=bukti_praktik
POSTGRES_PORT=5432
POSTGRES_USER=bukti
POSTGRES_PASSWORD=bukti_local_password
DATABASE_URL=postgresql://bukti:bukti_local_password@localhost:5432/bukti_praktik

S3_ENDPOINT=http://localhost:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin123
S3_BUCKET=bukti-praktik
S3_FORCE_PATH_STYLE=true

GEMINI_API_KEY=
GEMINI_RUBRIC_MODEL=gemini-2.5-flash
GEMINI_MODEL=gemini-3.7-flash
GEMINI_REQUEST_TIMEOUT_MS=300000
GEMINI_FILE_PROCESSING_TIMEOUT_MS=180000
FAKE_AI=false

UPLOAD_MAX_BYTES=104857600
UPLOAD_MAX_DURATION_SECONDS=120
WORKER_POLL_MS=2000
WORKER_MAX_ATTEMPTS=3
WORKER_LEASE_MS=300000
WORKER_HEARTBEAT_MS=30000
SHARE_TTL_HOURS=168
DEFAULT_ORGANIZATION_SLUG=smk-demo

SEED_ASSESSOR_NAME=Asesor Demo
SEED_ASSESSOR_EMAIL=asesor@bukti.local
SEED_ASSESSOR_PASSWORD=DemoAsesor123!
LOG_LEVEL=info
